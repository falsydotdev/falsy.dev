---
import { consultancy, person } from '../config/brand';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="inner glass">
    <p class="credits">
      Mars terrain from USGS Astrogeology: MOLA elevation and the Viking MDIM 2.1 colour mosaic. Moon terrain from NASA/GSFC/Arizona State University: LOLA elevation, and LROC colour by NASA's Scientific Visualization Studio. Earth from NASA's Blue Marble, by the Scientific Visualization Studio.
    </p>
    <p class="meta">
      <span>© {year} {person.name}</span>
      <a href={person.github}>GitHub</a>
      <a href={person.linkedin}>LinkedIn</a>
      <a href={consultancy.url}>{new URL(consultancy.url).hostname}</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    padding: 0 var(--gutter) 96px;
  }

  .inner {
    display: grid;
    gap: 14px;
    max-width: 62rem;
    padding: 22px 24px;
  }

  .credits {
    color: var(--muted);
    font-size: var(--step--1);
    max-width: 65ch;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    font: 400 var(--step--2) / 1.4 var(--data);
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  .meta a {
    color: var(--accent);
    text-decoration: none;
  }

  .meta a:hover {
    text-decoration: underline;
  }

  /* Wide screens: links stack on the right, so the credits keep a readable line length without leaving the box half empty. */
  @media (min-width: 52rem) {
    .inner {
      grid-template-columns: minmax(0, 65ch) auto;
      justify-content: space-between;
      align-items: end;
      column-gap: 48px;
    }

    .meta {
      flex-direction: column;
      align-items: flex-end;
      text-align: right;
    }
  }
</style>
