---
const links = [
  { href: '/#projects', text: 'projects' },
  { href: '/#consulting', text: 'consulting' },
  { href: '/#about', text: 'about' },
  { href: '/#contact', text: 'contact' },
];
---

<header class="site-header" data-header>
  <a class="home" href="/" aria-label="falsy.dev home">falsy<span>.dev</span></a>
  <nav aria-label="Main">
    <ul>
      {links.map((l) => <li><a href={l.href}>{l.text}</a></li>)}
    </ul>
  </nav>
</header>

<script>
  // Clear at the top, glass once content scrolls under it, out of the way while reading
  // downward, back as soon as the reader scrolls up. One listener serves every page swap.
  const DELTA = 6;
  const HIDE_AFTER = 160;
  let lastY = scrollY;
  let queued = false;

  function update() {
    queued = false;
    const header = document.querySelector<HTMLElement>('[data-header]');
    if (!header) return;
    const y = Math.max(0, scrollY);
    header.toggleAttribute('data-scrolled', y > 8);
    if (y < HIDE_AFTER) header.removeAttribute('data-hidden');
    else if (y > lastY + DELTA) header.setAttribute('data-hidden', '');
    else if (y < lastY - DELTA) header.removeAttribute('data-hidden');
    if (Math.abs(y - lastY) > DELTA || y < HIDE_AFTER) lastY = y;
  }

  addEventListener(
    'scroll',
    () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    },
    { passive: true },
  );
  document.addEventListener('astro:page-load', () => {
    lastY = scrollY;
    update();
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 32px;
    padding: max(20px, env(safe-area-inset-top, 0px)) var(--gutter) 14px;
    margin-bottom: -14px;
    border-bottom: 1px solid transparent;
    transition:
      transform 260ms ease,
      background-color 300ms ease,
      border-color 300ms ease;
    padding-left: max(var(--gutter), env(safe-area-inset-left, 0px));
    padding-right: max(var(--gutter), env(safe-area-inset-right, 0px));
    font: 400 var(--step--1) / 1 var(--data);
    letter-spacing: 0.06em;
  }

  .site-header[data-scrolled] {
    background: var(--glass-strong);
    border-bottom-color: var(--glass-line);
    -webkit-backdrop-filter: blur(16px) saturate(1.15);
    backdrop-filter: blur(16px) saturate(1.15);
  }

  /* Keyboard users tabbing into a hidden header bring it back. */
  .site-header[data-hidden]:not(:focus-within) {
    transform: translateY(-100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header[data-hidden]:not(:focus-within) {
      transform: none;
    }
  }

  .home {
    color: var(--ink);
    text-decoration: none;
  }

  .home span {
    color: var(--accent);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 26px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
    padding-block: 6px;
  }

  nav a::before {
    content: '/';
    color: var(--accent);
    margin-right: 0.35em;
  }

  nav a:hover {
    color: var(--ink);
  }
</style>
