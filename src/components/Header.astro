---
const links = [
  { href: '/#projects', text: 'projects' },
  { href: '/#consulting', text: 'consulting' },
  { href: '/#about', text: 'about' },
  { href: '/#contact', text: 'contact' },
];
---

<header class="site-header" data-header>
  <a class="home" href="/" aria-label="falsy.dev home">
    <svg class="mark" viewBox="0 0 100 100" aria-hidden="true">
      <circle class="night" cx="50" cy="50" r="38"></circle>
      <path class="day" d="M50 12A38 38 0 0 1 50 88A11 38 0 0 1 50 12Z"></path>
      <circle class="rim" cx="50" cy="50" r="38"></circle>
    </svg>
    <span class="name">falsy</span><span class="tld">.dev</span>
  </a>
  <nav aria-label="Main">
    <ul>
      {links.map((l) => <li><a href={l.href}>{l.text}</a></li>)}
    </ul>
  </nav>
</header>

<script>
  // Clear at the top, glass once content scrolls under it. One listener serves every page swap.
  let queued = false;

  function update() {
    queued = false;
    document.querySelector('[data-header]')?.toggleAttribute('data-scrolled', scrollY > 8);
  }

  addEventListener(
    'scroll',
    () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    },
    { passive: true },
  );
  document.addEventListener('astro:page-load', update);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 32px;
    padding: max(20px, env(safe-area-inset-top, 0px)) var(--gutter) 14px;
    margin-bottom: -14px;
    border-bottom: 1px solid transparent;
    transition:
      background-color 300ms ease,
      border-color 300ms ease;
    padding-left: max(var(--gutter), env(safe-area-inset-left, 0px));
    padding-right: max(var(--gutter), env(safe-area-inset-right, 0px));
    font: 400 var(--step--1) / 1 var(--data);
    letter-spacing: 0.06em;
  }

  .site-header[data-scrolled] {
    background: var(--glass-strong);
    border-bottom-color: var(--glass-line);
    -webkit-backdrop-filter: blur(16px) saturate(1.15);
    backdrop-filter: blur(16px) saturate(1.15);
  }

  .home {
    display: inline-flex;
    align-items: baseline;
    color: var(--ink);
    text-decoration: none;
  }

  .mark {
    align-self: center;
    width: 22px;
    height: 22px;
    margin-right: 9px;
  }

  .night {
    fill: color-mix(in srgb, var(--accent) 14%, #0d121a);
  }

  .day {
    fill: var(--accent);
  }

  .rim {
    fill: none;
    stroke: var(--accent);
    stroke-opacity: 0.4;
    stroke-width: 3;
  }

  .name {
    font: 400 1.625rem / 1 var(--display);
    letter-spacing: 0;
  }

  .tld {
    color: var(--accent);
    margin-left: 0.04em;
    letter-spacing: 0.04em;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 26px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
    padding-block: 6px;
  }

  nav a::before {
    content: '/';
    color: var(--accent);
    margin-right: 0.35em;
  }

  nav a:hover {
    color: var(--ink);
  }
</style>
