---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { title, label, line, tags } = project.data;
---

<article class="card glass">
  <p class="label">{label}</p>
  <h3><a href={`/projects/${project.id}`}>{title}</a></h3>
  <p class="line">{line}</p>
  <ul class="tags" aria-label="Stack">
    {tags.map((t) => <li>{t}</li>)}
  </ul>
</article>

<style>
  .card {
    display: grid;
    align-content: start;
    gap: 12px;
    padding: 22px 22px 20px;
    transition: border-color 160ms ease;
  }

  .card:hover,
  .card:focus-within {
    border-color: rgba(156, 198, 236, 0.55);
  }

  h3 {
    font-size: var(--step-2);
  }

  h3 a {
    text-decoration: none;
  }

  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .line {
    color: var(--muted);
    font-size: var(--step--1);
    line-height: 1.5;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
    font: 300 var(--step--2) / 1.3 var(--data);
    color: var(--muted);
  }
</style>
