---
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <ClientRouter />
    <style is:global>
      html, body { margin: 0; background: #000; color: #eee; font-family: system-ui; }
      #stage { position: fixed; inset: 0; z-index: -1; }
      main { position: relative; padding: 48px; }
    </style>
  </head>
  <body>
    <div id="stage" transition:persist="stage"></div>
    <slot />
    <script>
      import { startSpike } from '../scene/boot';
      const params = new URLSearchParams(location.search);
      const host = document.getElementById('stage');
      if (host) startSpike(host, params.has('webgl'));
    </script>
  </body>
</html>
