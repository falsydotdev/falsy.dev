---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { consultancy, person } from '../config/brand';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Base>
  <section class="hero" aria-labelledby="hero-title">
    <p class="label">falsy.dev</p>
    <h1 id="hero-title">Justin <em>Powell</em></h1>
    <p class="lede">
      I build AI revenue systems for B2B SaaS teams, mostly in HubSpot. I studied physics and economics, and I've worked in RevOps since 2012.
    </p>
    <div class="actions">
      <a class="button primary" href={person.bookingUrl} data-track="book-call">Book a call</a>
      <a class="text-link" href="#projects">See my projects</a>
    </div>
  </section>

  <section id="consulting" class="panel glass" aria-labelledby="consulting-title">
    <p class="label">01 / Consulting</p>
    <h2 id="consulting-title">Consulting</h2>
    <p>
      I run {consultancy.name}, a small consultancy for founders and COOs at B2B SaaS companies. I build one revenue system at a time, for a fixed price, in the stack you already use. Most builds are live in about 30 days.
    </p>

    <div class="split">
      <div>
        <h3>Example builds</h3>
        <ul class="builds">
          <li><strong>Inbound engine:</strong> new leads get enriched, routed and followed up, without anyone copying data between tools.</li>
          <li><strong>Renewal pipeline:</strong> renewals show up in HubSpot months ahead, each with an owner and a next step.</li>
          <li><strong>Forecasting and internal tools:</strong> a forecast you can check line by line, plus the small tools your team keeps asking for.</li>
        </ul>
      </div>
      <div>
        <h3>How it works</h3>
        <ol class="steps">
          <li>A free 30-minute scoping call.</li>
          <li>A fixed-price proposal.</li>
          <li>About four weeks of building, in HubSpot most of the time.</li>
          <li>Handover and training, so your team runs it from there.</li>
        </ol>
      </div>
    </div>

    <p class="aside">I don't bill by the hour, write strategy decks without building anything, or do Salesforce admin.</p>

    <div class="proof">
      <p>
        I've been the first RevOps hire through one IPO and two acquisitions. Clients include UpGuard, Sherlok and Elita. {consultancy.name} is a {consultancy.partner}.
      </p>
      <p>
        At Magnific (formerly Freepik), I led the AI rebuild of a legacy product. It went from zero to hundreds of thousands of weekly users and drove a third of all new subscriptions.
      </p>
    </div>

    <div class="actions">
      <a class="button primary" href={person.bookingUrl} data-track="book-call">Book a scoping call</a>
      <a class="button secondary" href={consultancy.url}>More at {new URL(consultancy.url).hostname}</a>
    </div>
  </section>

  <section id="projects" class="projects" aria-labelledby="projects-title">
    <div class="projects-head">
      <p class="label">02 / Projects</p>
      <h2 id="projects-title">Projects</h2>
    </div>
    <div class="cards">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  <section id="about" class="panel glass" aria-labelledby="about-title">
    <p class="label">03 / About</p>
    <h2 id="about-title">About</h2>
    <p>
      I'm {person.firstName}. I'm American, I live in Adelaide, and I've worked in RevOps since 2012, in the US, the UK, Germany and Australia.
    </p>
    <p>
      I studied physics for four years, first at the University of Arizona and then at the University of Utah, and graduated with a degree in economics and a minor in physics. Physics taught me to measure something before I try to change it. I still work that way: I look at what's actually in your CRM before I suggest a fix.
    </p>
    <p>
      The planet behind this page is rendered from real NASA and USGS data. It's a still frame, lit by where the Sun really was at the time shown in the bottom corner. I built it because I like space and wanted my site to show the kind of work I do.
    </p>
  </section>

  <section id="contact" class="panel glass" aria-labelledby="contact-title">
    <p class="label">04 / Contact</p>
    <h2 id="contact-title">Contact</h2>
    <p>The quickest way to start is a 30-minute call. I work Adelaide hours, and the booking page shows times in your time zone.</p>
    <div class="actions">
      <a class="button primary" href={person.bookingUrl} data-track="book-call">Book a call</a>
    </div>
    <p class="email">
      <span class="label">Email</span>
      <a href={`mailto:${person.email}`}>{person.email}</a>
    </p>
  </section>
</Base>

<style>
  section {
    margin-inline: var(--gutter);
  }

  .hero {
    display: grid;
    align-content: start;
    gap: 22px;
    min-height: calc(100svh - 64px);
    padding-top: clamp(48px, 12vh, 140px);
    max-width: 44rem;
  }

  h1 {
    font-size: var(--step-4);
    line-height: 0.92;
  }

  .lede {
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--muted);
    max-width: 34rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 26px;
    margin-top: 6px;
  }

  .text-link {
    font: 400 var(--step--1) / 1 var(--data);
    letter-spacing: 0.04em;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--glass-line);
    padding-bottom: 6px;
  }

  .text-link:hover {
    border-color: var(--accent);
  }

  .panel {
    display: grid;
    gap: 20px;
    max-width: 62rem;
    margin-bottom: 40px;
    padding: clamp(24px, 4vw, 48px);
  }

  .panel > p,
  .proof p {
    max-width: 65ch;
  }

  h2 {
    font-size: var(--step-3);
    margin-bottom: 4px;
  }

  h3 {
    font: 500 var(--step--1) / 1.2 var(--data);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 14px;
  }

  .split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 28px 48px;
    margin-block: 8px;
  }

  .builds,
  .steps {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .builds li {
    padding-left: 18px;
    border-left: 1px solid var(--glass-line);
  }

  .builds strong {
    font-weight: 600;
  }

  .steps {
    counter-reset: step;
  }

  .steps li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 2.6em 1fr;
  }

  .steps li::before {
    content: '0' counter(step);
    font: 400 var(--step--1) / 1.9 var(--data);
    color: var(--accent);
  }

  .aside {
    color: var(--muted);
    font-style: italic;
  }

  .proof {
    display: grid;
    gap: 14px;
    padding-top: 20px;
    border-top: 1px solid var(--grid);
    color: var(--muted);
  }

  .projects {
    display: grid;
    gap: 22px;
    max-width: 62rem;
    margin-block: 72px 112px;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 18px;
  }

  .email {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 14px;
  }

  .email a {
    font: 400 var(--step-0) / 1.4 var(--data);
    color: var(--ink);
    text-decoration-color: var(--glass-line);
    text-underline-offset: 5px;
    user-select: all;
  }

  #about {
    margin-top: 0;
  }
</style>
